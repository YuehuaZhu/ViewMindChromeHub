{
  "name": "viewmind-chrome-hub",
  "description": "Tab 管理 + 浏览 context 采集，数字分身底座。Chromium MV3 扩展，本地优先。",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turndown": "^7.2.4"
  }
}
